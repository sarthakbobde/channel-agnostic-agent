# Environment configuration for Channel Agnostic Agent

# LLM Service (9Router)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=sk-your-api-key-here
LLM_MODEL=testcombo

# Storage
CHAT_DIR=./chats
CHROMA_PATH=./chroma_db
COLLECTION_NAME=docs

# RAG Parameters
TOP_K=5
SCORE_THRESHOLD=0.35
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MEMORY_MAX_TURNS=6

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Microsoft Teams (Azure Bot)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# Google Chat
GCHAT_AUDIENCE=
GCHAT_SERVICE_ACCOUNT_EMAIL=

# Admin (encrypts stored channel credentials; generate: python -m app.secretstore generate)
APP_SECRET_KEY=
ADMIN_DB_PATH=./admin_data/admin.db
ADMIN_EMAIL_DOMAIN=sysfore.com
# Only set true behind HTTPS and your own access controls; the admin API is local-only by default.
ADMIN_ALLOW_REMOTE=false
# Browser origins allowed to call the API (comma-separated). Empty = none.
CORS_ORIGINS=
