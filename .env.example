# Environment configuration for Channel Agnostic Agent

# LLM Service (9Router)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=sk-your-api-key-here
LLM_MODEL=testcombo

# Storage
CHAT_DIR=./chats
CHROMA_PATH=./chroma_db
COLLECTION_NAME=docs

# RAG Parameters
TOP_K=5
SCORE_THRESHOLD=0.35
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MEMORY_MAX_TURNS=6

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Microsoft Teams (Azure Bot)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# Google Chat
GCHAT_AUDIENCE=
GCHAT_SERVICE_ACCOUNT_EMAIL=

# Admin (encrypts stored channel credentials; generate: python -m app.secretstore generate)
APP_SECRET_KEY=
ADMIN_DB_PATH=./admin_data/admin.db
ADMIN_EMAIL_DOMAIN=sysfore.com
# Only set true behind HTTPS and your own access controls; the admin API is local-only by default.
ADMIN_ALLOW_REMOTE=false
# Browser origins allowed to call the API (comma-separated). Empty = none.
CORS_ORIGINS=

# Chat API service token: REQUIRED. For service callers (scripts, tests); without it /chat and /conversations refuse
# every request. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAT_API_TOKEN=

# Optional: PostgreSQL instead of the SQLite file, e.g. postgresql+psycopg://user:pass@localhost:5432/agent
DATABASE_URL=

# docker compose only: host port the container is published on (127.0.0.1 only)
HOST_PORT=8000

# Where one-time password links for Viewers point (the web chat)
WEB_UI_URL=http://localhost:8501

# Signs the web chat's sign-in cookie (webchat/). Generate: chainlit create-secret
CHAINLIT_AUTH_SECRET=

# Run the admin page on its own port (recommended before exposing the app through a tunnel).
# 0 = admin shares the main port. With a port set, the main port serves no admin route at all.
ADMIN_PORT=0
ADMIN_HOST=127.0.0.1
# Remote admin (ADMIN_ALLOW_REMOTE=true) requires HTTPS unless you turn this off, which is only
# sensible when the port is reachable from this machine alone.
ADMIN_REQUIRE_HTTPS=true
# Optional: the admin center's public address, e.g. https://agent.example.com. Used for the return address of
# "Sign in with Microsoft / Google" (Settings > Sign-in). Empty = the address the browser used.
ADMIN_PUBLIC_URL=

# Uploaded originals (one folder per knowledge base) and the upload size limit
DOCS_DIR=./data/kb_files
MAX_UPLOAD_MB=25

# Guardrails: first-start default only (afterwards the Guardrails screen decides)
GUARDRAILS_ENABLED=true

# Where downloaded embedding models are kept (the local multilingual model is about 129 MB)
MODELS_DIR=./models
